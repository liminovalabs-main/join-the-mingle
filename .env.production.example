# ============================================================
# Project Mingler — Production Environment Configuration
# ============================================================
# Copy this file to .env.production on the Hostinger VPS.
# NEVER commit .env.production to Git.

# --- Django Core ---
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mingler.co.uk,www.mingler.co.uk,localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.production
FRONTEND_URL=https://mingler.co.uk
CORS_ALLOWED_ORIGINS=https://mingler.co.uk,https://www.mingler.co.uk

# --- PostgreSQL ---
POSTGRES_DB=mingler_prod
POSTGRES_USER=mingler_admin
POSTGRES_PASSWORD=generate-a-secure-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://mingler_admin:generate-a-secure-database-password@db:5432/mingler_prod

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...

# --- Email / SMTP (Verification OTPs, Password Resets, Booking Confirmations) ---
# If using Hostinger Business Email:
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=hello@mingler.co.uk
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=Mingler <hello@mingler.co.uk>

# --- Cloudflare R2 Media Storage (Optional: Leave empty for local volume) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=mingler-media
CLOUDFLARE_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.mingler.co.uk

# --- JWT Auth Lifetime ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
