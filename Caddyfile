{
    email hello@mingler.co.uk
    admin off
}

# Production Reverse Proxy for Mingler Platform (Handbook Chapter 07)
{$DOMAIN:mingler.co.uk} {
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # High-speed static files directly from shared volume
    handle_path /static/* {
        root * /var/www/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Uploaded media assets directly from shared volume
    handle_path /media/* {
        root * /var/www/media
        file_server
    }

    # Route API, Admin, and Health probes to Django backend
    @django path /api /api/* /admin /admin/* /health /health/*
    handle @django {
        reverse_proxy backend:8000
    }

    # Next.js Frontend (SSR & Static pages)
    handle {
        reverse_proxy frontend:3000
    }
}

# Permanent 301 Redirect for www to apex domain
{$WWW_DOMAIN:www.mingler.co.uk} {
    redir https://{$DOMAIN:mingler.co.uk}{uri} permanent
}
