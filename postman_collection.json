            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout", ""]
            },
            "description": "Invalidates the refresh token in the blacklist."
          }
        },
        {
          "name": "Social Auth - 1. Get Consent URL (Google, Apple, Facebook, Instagram, TikTok, LinkedIn)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/social/url/?provider=google&redirect_uri=http://localhost:3000/auth/callback&state=random_csrf_token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "social", "url", ""],
              "query": [
                {
                  "key": "provider",
                  "value": "google",
                  "description": "google | apple | facebook | instagram | tiktok | linkedin"
                },
                {
                  "key": "redirect_uri",
                  "value": "http://localhost:3000/auth/callback"
                },
                {
                  "key": "state",
                  "value": "random_csrf_token"
                }
              ]
            },
            "description": "Generates provider-specific OAuth2 authorization URL with required scopes and credentials."
          }
        },
        {
          "name": "Social Auth - 2. Login / Register (Token or Code Exchange)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "    if (jsonData.profile) {",
                  "        pm.collectionVariables.set('my_profile_id', jsonData.profile.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"token\": \"<ID_TOKEN_OR_ACCESS_TOKEN_FROM_CLIENT_SDK>\",\n  \"code\": \"\",\n  \"redirect_uri\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/social/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "social", "login", ""]
            },
            "description": "Authenticates or registers a member via Google, Apple, Facebook, Instagram, TikTok, or LinkedIn. Automatically provisions profile and sets JWT tokens."
          }
        },
        {
          "name": "Social Auth - 3. List Connected Social Accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
