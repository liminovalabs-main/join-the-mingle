  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register New Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.profile) {",
                  "        pm.collectionVariables.set('my_profile_id', jsonData.profile.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meriam@mingler.co.uk\",\n  \"password\": \"SecureMingle2026!\",\n  \"password_confirm\": \"SecureMingle2026!\",\n  \"display_name\": \"Meriam London\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register", ""]
            },
            "description": "Registers a new member (inactive and unverified by default) and sends 6-digit OTP to user's email. Tokens are issued once verified."
          }
        },
        {
          "name": "Verify Email (6-Digit OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.tokens) {",
                  "        pm.collectionVariables.set('access_token', jsonData.tokens.access);",
                  "        pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meriam@mingler.co.uk\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-email/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-email", ""]
            },
            "description": "Submits 6-digit OTP code to verify the member's email address and mark account verified."
          }
        },
        {
          "name": "Resend Verification Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meriam@mingler.co.uk\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/resend-verification/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "resend-verification", ""]
            },
            "description": "Dispatches a new 6-digit OTP verification code to the registered email address (enforces 60-second cooldown)."
          }
        },
        {
          "name": "Password Reset 1: Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meriam@mingler.co.uk\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password-reset/request/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password-reset", "request", ""]
            },
            "description": "Dispatches a 6-digit password reset OTP code to the registered email address (valid for 15 minutes)."
          }
        },
        {
          "name": "Password Reset 2: Verify Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meriam@mingler.co.uk\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password-reset/verify-code/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password-reset", "verify-code", ""]
            },
            "description": "Verifies that the 6-digit password reset OTP is valid before rendering new password input form."
          }
        },
        {
          "name": "Password Reset 3: Confirm & Set New Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meriam@mingler.co.uk\",\n  \"code\": \"123456\",\n  \"new_password\": \"NewSecurePassword2026!\",\n  \"new_password_confirm\": \"NewSecurePassword2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password-reset/confirm/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password-reset", "confirm", ""]
            },
            "description": "Validates the 6-digit OTP code and updates the account with the new password."
          }
        },
        {
          "name": "Login (Obtain JWT Tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "    pm.collectionVariables.set('my_profile_id', jsonData.profile.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meriam@mingler.co.uk\",\n  \"password\": \"SecureMingle2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login", ""]
