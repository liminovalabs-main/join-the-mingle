            "url": {
              "raw": "{{base_url}}/api/v1/auth/social/accounts/google/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "social", "accounts", "google", ""]
            },
            "description": "Unlinks a social provider account (protected against accidental lockout if no password exists)."
          }
        }
      ]
