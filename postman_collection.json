            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/social/accounts/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "social", "accounts", ""]
            },
            "description": "Lists all third-party social accounts linked to the authenticated user."
