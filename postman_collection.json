    {
      "name": "5. Bookings & Concurrency",
      "item": [
        {
          "name": "Create Reservation (Concurrency Safe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.booking && jsonData.booking.id) {",
                  "        pm.collectionVariables.set('booking_id', jsonData.booking.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mingle_id\": \"{{mingle_id}}\",\n  \"places_booked\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ""]
            },
            "description": "Reserve 1 to 5 seats. Employs select_for_update() row lock and past-date guard."
          }
        },
        {
          "name": "My Bookings History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
