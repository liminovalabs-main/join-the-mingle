              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", "my-bookings", ""]
            },
            "description": "Lists all past and upcoming reservations for the logged-in member."
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
